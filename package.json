{
  "name": "@platformatic/kafka",
  "version": "2.14.0",
  "description": "Modern and performant client for Apache Kafka",
  "homepage": "https://github.com/platformatic/kafka",
  "author": "Platformatic Inc. <oss@platformatic.dev> (https://platformatic.dev)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platformatic/kafka.git"
  },
  "keywords": [
    "kafka"
  ],
  "bugs": {
    "url": "https://github.com/platformatic/kafka/issues"
  },
  "private": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.base.json",
    "postbuild": "./scripts/node scripts/postbuild.ts",
    "lint": "eslint --cache",
    "typecheck": "tsc -p . --noEmit",
    "format": "prettier -w benchmarks playground regression src test",
    "prepare": "npm run build",
    "test": "c8 -c test/config/c8-local.json ./scripts/node --test --test-reporter=cleaner-spec-reporter 'test/*.test.ts' 'test/*/*.test.ts' 'test/*/*/*.test.ts'",
    "test:ci": "./scripts/node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 --test-reporter=cleaner-spec-reporter 'test/*.test.ts' 'test/*/*.test.ts' 'test/*/*/*.test.ts'",
    "test:integrity": "./scripts/node --test --test-reporter=cleaner-spec-reporter 'regression/integrity/*.test.ts'",
    "test:performance": "./scripts/node --test --test-concurrency=1 --test-reporter=cleaner-spec-reporter 'regression/performance/*.test.ts'",
    "test:regression": "npm run test:integrity",
    "test:regression:all": "npm run test:integrity && npm run test:performance",
    "test:all": "npm test && npm run test:regression:all",
    "test:compat": "./scripts/node --test --test-reporter=cleaner-spec-reporter 'test/integration/*.compat-test.ts'",
    "test:memory": "NODE_OPTIONS='--expose-gc' ./scripts/node --test --test-reporter=cleaner-spec-reporter 'test/**/*.memory-test.ts'",
    "test:e2e:upgrade": "./scripts/node --test --test-reporter=cleaner-spec-reporter 'test/e2e/client-upgrade.e2e-test.ts'",
    "test:e2e:redpanda": "./scripts/node --test --test-reporter=cleaner-spec-reporter 'test/e2e/redpanda.e2e-test.ts'",
    "test:e2e:eventhubs": "./scripts/node --test --test-reporter=cleaner-spec-reporter 'test/e2e/eventhubs.e2e-test.ts'",
    "test:e2e:oracle-streaming": "./scripts/node --test --test-reporter=cleaner-spec-reporter 'test/e2e/oracle-streaming.e2e-test.ts'",
    "test:docker:up": "docker-compose up -d --wait",
    "test:docker:down": "docker-compose down",
    "regression:baseline:compare": "npm run test:performance",
    "regression:baseline:update": "./scripts/node regression/helpers/run-benchmarks.ts",
    "ci": "npm run build && npm run lint && npm run test:ci",
    "prepublishOnly": "npm run build && npm run lint",
    "postpublish": "git push origin && git push origin -f --tags",
    "generate:apis": "node scripts/generate-apis.ts",
    "generate:errors": "node scripts/generate-errors.ts",
    "create:api": "node scripts/create-api.ts"
  },
  "dependencies": {
    "@platformatic/dynamic-buffer": "^0.4.0",
    "@platformatic/wasm-utils": "^0.3.0",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "avsc": "^5.7.9",
    "debug": "^4.4.3",
    "fastq": "^1.20.3",
    "mnemonist": "^0.40.5",
    "scule": "^1.3.0"
  },
  "optionalDependencies": {
    "@node-rs/crc32": "^1.10.8",
    "protobufjs": "^8.8.0"
  },
  "devDependencies": {
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.6",
    "@babel/traverse": "^8.0.6",
    "@babel/types": "^8.0.6",
    "@confluentinc/kafka-javascript": "^1.10.1",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@platformatic/rdkafka": "^4.1.2",
    "@swc-node/register": "^1.12.1",
    "@types/debug": "^4.1.13",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "@watchable/unpromise": "^1.0.2",
    "c8": "^12.0.0",
    "cleaner-spec-reporter": "^2.0.1",
    "cronometro": "^7.0.1",
    "eslint": "^9.39.5",
    "fast-jwt": "^6.3.4",
    "hwp": "^0.5.0",
    "import-in-the-middle": "^3.5.2",
    "json5": "^2.2.3",
    "kafkajs": "^2.2.4",
    "kerberos": "^7.0.0",
    "lz4-napi": "^2.10.0",
    "neostandard": "^0.13.0",
    "parse5": "^8.0.1",
    "prettier": "^3.9.9",
    "prettier-plugin-space-before-function-paren": "^0.1.0",
    "prom-client": "^15.1.3",
    "semver": "^7.8.5",
    "snappy": "^7.4.3",
    "table": "^6.9.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.22.0 || >= 24.6.0"
  },
  "typesVersions": {
    "<5.0": {
      "*": [
        "dist/typescript-4/*"
      ]
    }
  }
}